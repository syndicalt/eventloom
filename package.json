{
  "name": "@eventloom/runtime",
  "version": "1.0.0",
  "type": "module",
  "description": "Append-only event-log runtime for multi-agent AI systems",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./export/halo": {
      "types": "./dist/export/halo.d.ts",
      "import": "./dist/export/halo.js"
    },
    "./export/otlp": {
      "types": "./dist/export/otlp.d.ts",
      "import": "./dist/export/otlp.js"
    },
    "./export/pathlight": {
      "types": "./dist/export/pathlight.d.ts",
      "import": "./dist/export/pathlight.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/README.md",
    "docs/benchmarks.md",
    "docs/package-api.md",
    "docs/public-api.md",
    "docs/custom-workflows.md",
    "docs/agent-journal-cookbook.md",
    "docs/github-actions-artifacts.md",
    "docs/migration-v1.md",
    "docs/cli-reference.md",
    "docs/user-guide.md",
    "docs/agent-integration.md",
    "docs/case-studies",
    "docs/architecture.md",
    "docs/event-model.md",
    "docs/workflows.md",
    "docs/pathlight-integration.md",
    "docs/halo-integration.md",
    "docs/otlp-integration.md",
    "fixtures/sample.jsonl",
    "fixtures/export",
    "examples/custom-workflow.ts",
    "fixtures/golden"
  ],
  "scripts": {
    "build": "npm run build:runtime",
    "build:runtime": "node scripts/clean-dist.mjs dist && tsc && node scripts/chmod-cli-bins.mjs dist/cli.js",
    "build:mcp": "npm run build:runtime && npm --prefix packages/mcp run build",
    "bench": "tsx scripts/benchmarks/large-log.ts --mode full",
    "bench:smoke": "tsx scripts/benchmarks/large-log.ts --mode smoke",
    "bench:export": "tsx scripts/benchmarks/large-log.ts --mode export",
    "bench:evidence:check": "node scripts/check-benchmark-evidence.mjs",
    "fixtures:golden": "tsx scripts/generate-golden-fixtures.ts",
    "fixtures:golden:check": "node scripts/check-golden-fixtures.mjs",
    "fixtures:export": "tsx scripts/generate-export-fixtures.ts",
    "audit:runtime": "npm audit --omit=dev",
    "audit:mcp": "npm --prefix packages/mcp audit --omit=dev",
    "smoke:mcp-local-runtime": "node scripts/smoke-mcp-local-runtime.mjs",
    "smoke:mcp-installed-bin": "npm --prefix packages/mcp run smoke:installed-bin",
    "smoke:mcp-v1-local-runtime-bin": "npm --prefix packages/mcp run smoke:v1-local-runtime-bin",
    "smoke:custom-workflow-package": "node scripts/smoke-custom-workflow-package.mjs",
    "smoke:runtime-installed-cli": "node scripts/smoke-runtime-installed-cli.mjs",
    "release:preflight:v1": "node scripts/release-preflight.mjs --target 1.0.0",
    "release:preflight:v1:local": "node scripts/release-preflight.mjs --target 1.0.0 --no-git",
    "publish:runtime-v1": "npm run ci:runtime-v1 && npm run release:preflight:mcp-v1-staged:local && npm run release:preflight:runtime-v1 && npm publish --access public",
    "publish:mcp-v1": "npm run ci:full-v1 && npm run release:preflight:mcp-v1 && npm --prefix packages/mcp publish --access public",
    "ci": "npm run ci:runtime-v1",
    "ci:runtime-v1": "npm run test:runtime && npm run fixtures:golden:check && npm run fixtures:check && npm run bench:smoke && npm run audit:runtime && npm run smoke:mcp-local-runtime && npm run smoke:mcp-v1-local-runtime-bin && npm run smoke:custom-workflow-package && npm run smoke:runtime-installed-cli && npm run pack:check && npm pack --dry-run",
    "ci:mcp-v1": "npm run test:mcp && npm run build:mcp && npm run audit:mcp && npm run smoke:mcp-installed-bin && npm run pack:check && npm pack --dry-run ./packages/mcp",
    "ci:full-v1": "npm run ci:runtime-v1 && npm run ci:mcp-v1",
    "test:mcp": "npm --prefix packages/mcp test",
    "prepack": "npm run test:runtime",
    "test": "npm run test:runtime",
    "test:runtime": "npm run build:mcp && vitest run",
    "eventloom": "tsx src/cli.ts",
    "fixtures:check": "node scripts/check-export-fixtures.mjs",
    "pack:check": "node scripts/check-pack-manifests.mjs",
    "release:preflight:runtime-v1": "node scripts/release-preflight.mjs --target 1.0.0 --phase runtime",
    "release:preflight:runtime-v1:local": "node scripts/release-preflight.mjs --target 1.0.0 --phase runtime --no-git",
    "release:preflight:mcp-v1": "node scripts/release-preflight.mjs --target 1.0.0 --phase mcp --check-published-runtime",
    "release:preflight:mcp-v1:local": "node scripts/release-preflight.mjs --target 1.0.0 --phase mcp --no-git",
    "release:preflight:mcp-v1-staged:local": "node scripts/release-preflight-mcp-v1-local-staged.mjs"
  },
  "bin": {
    "eventloom": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agents",
    "event-log",
    "workflow",
    "runtime",
    "multi-agent",
    "observability",
    "pathlight",
    "halo",
    "otlp",
    "opentelemetry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syndicalt/eventloom.git"
  },
  "bugs": {
    "url": "https://github.com/syndicalt/eventloom/issues"
  },
  "homepage": "https://github.com/syndicalt/eventloom#readme",
  "author": "Nicholas Blanchard <syndicalt@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "fast-check": "^4.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  },
  "license": "MIT",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  }
}
